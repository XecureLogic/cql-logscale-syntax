{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CrowdStrike Query Language",
  "scopeName": "source.cql",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#regex" },
    { "include": "#tags" },
    { "include": "#metadata-fields" },
    { "include": "#query-parameters" },
    { "include": "#constants" },
    { "include": "#time-literals" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#controls" },
    { "include": "#logical-operators" },
    { "include": "#named-parameters" },
    { "include": "#field-list" },
    { "include": "#assignment" },
    { "include": "#operators" },
    { "include": "#fields" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cql",
          "begin": "//",
          "end": "$",
          "patterns": [
            { "name": "constant.other.url.cql", "match": "https?://\\S+" }
          ]
        },
        {
          "name": "comment.block.cql",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cql",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.cql", "match": "\\\\." }
          ]
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.cql",
          "match": "/(?:\\\\.|[^/\\\\\\n])+/[a-zA-Z]*"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "entity.name.tag.cql",
          "match": "#[A-Za-z_][\\w.]*"
        }
      ]
    },
    "metadata-fields": {
      "patterns": [
        {
          "name": "variable.language.cql",
          "match": "@[A-Za-z_][\\w.]*"
        }
      ]
    },
    "query-parameters": {
      "patterns": [
        {
          "name": "variable.parameter.query.cql",
          "match": "\\?[A-Za-z_]\\w*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.cql",
          "match": "(?i)\\b(true|false|null)\\b"
        }
      ]
    },
    "time-literals": {
      "patterns": [
        {
          "name": "constant.numeric.time.cql",
          "match": "(?i)\\b\\d+(?:milliseconds?|millis|ms|seconds?|secs?|s|minutes?|min|m|hours?|hrs?|hr|h|days?|d|weeks?|w|months?|mon|quarters?|qtrs?|qtr|q|years?|yrs?|yr|y)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cql",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.cql",
          "match": "\\b([A-Za-z_][\\w]*)\\s*(?=\\()"
        }
      ]
    },
    "controls": {
      "patterns": [
        {
          "name": "keyword.control.cql",
          "match": "\\b(case|match|default)\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.control.logical.cql",
          "match": "(?i)\\b(AND|OR|NOT|LIKE)\\b"
        }
      ]
    },
    "named-parameters": {
      "patterns": [
        {
          "name": "variable.parameter.cql",
          "match": "(?i)\\b(function|as|field|fields|by|order|limit|span|unit|timezone|tz|format|separator|sep|buckets|series|method|percentiles|nboundaries|window|measure|strip|distinct|precision)\\b(?=\\s*=)"
        }
      ]
    },
    "field-list": {
      "patterns": [
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.list.begin.cql" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.list.end.cql" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#regex" },
            { "include": "#tags" },
            { "include": "#metadata-fields" },
            { "include": "#query-parameters" },
            { "include": "#constants" },
            { "include": "#time-literals" },
            { "include": "#numbers" },
            { "include": "#functions" },
            { "include": "#logical-operators" },
            { "include": "#named-parameters" },
            { "include": "#operators" },
            { "name": "variable.other.field.cql", "match": "[A-Za-z_][\\w.]*" }
          ]
        }
      ]
    },
    "assignment": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.cql",
          "match": ":="
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.control.pipe.cql",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.comparison.cql",
          "match": "(!=|<=|>=|=~|=|<|>)"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.other.field.cql",
          "match": "\\b([A-Za-z_][\\w.]*(?:\\[\\d+\\])*)(?=\\s*(?::=|=~|!=|<=|>=|=|<|>))"
        }
      ]
    }
  }
}
